// Attach each layout to its status map.
&physical_layout_imprint_function_row_full_bottom_row {
    status-indicators = <&status_ind_function_row_5key>;
};
&physical_layout_imprint_function_row {
    status-indicators = <&status_ind_function_row_2key>;
};
&physical_layout_imprint_function_row_no_bottom_row {
    status-indicators = <&status_ind_function_row_no>;
};
