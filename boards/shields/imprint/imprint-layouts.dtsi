};
&physical_layout_imprint_number_row {
    status-indicators = <&status_ind_number_row_2key>;
};
&physical_layout_imprint_number_row_no_bottom_row {
    status-indicators = <&status_ind_number_row_no>;
};
&physical_layout_imprint_letters_only_full_bottom_row {
    status-indicators = <&status_ind_letters_only_5key>;
};
&physical_layout_imprint_letters_only {
    status-indicators = <&status_ind_letters_only_2key>;
};
