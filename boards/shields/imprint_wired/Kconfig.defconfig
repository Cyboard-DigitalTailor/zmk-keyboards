# Wired (RP2040, USB) Imprint — spike. See
# cyboard-wiki/projects/wired-zmk-migration.md.
#
# Unlike the wireless Imprint shield (BLE split, nRF52840), this shield targets
# an RP2040 board over USB and joins the two halves with ZMK's upstream wired
# split (zmk,wired-split, half-duplex). No BLE radio is present.

if SHIELD_IMPRINT_WIRED_LEFT

config ZMK_KEYBOARD_NAME
    default "Imprint Wired"

# Left is the wired-split central (the USB-attached half that talks to Studio).
config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif

if SHIELD_IMPRINT_WIRED_LEFT || SHIELD_IMPRINT_WIRED_RIGHT

config ZMK_SPLIT
    default y

config ZMK_SLEEP
    default y

# Save Studio/keymap changes ~1 s after the last edit instead of ZMK's 60 s
# default, matching the wireless Imprint, so a change made just before an
# unplug is not lost. Settings live in NVS on the RP2040's external flash.
config ZMK_SETTINGS_SAVE_DEBOUNCE
    default 1000

endif
