/*
 * Wired Imprint keymap (function row, 5-key bottom row) — spike default.
 *
 * Ported from the wired vial-qmk base layer
 * (keyboards/cyboard/imprint/imprint_function_row_5key_bottom_row). Bindings
 * are in this shield's matrix-transform order (82 keys); the per-key
 * correspondence to the physical board still needs bench verification against
 * the schematic. Users edit this live in Cyboard Studio once unlocked
 * (hold the A + F keys 3 s).
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC    &kp F1     &kp F2    &kp F3    &kp F4    &kp F5              &kp F6     &kp F7    &kp F8     &kp F9    &kp F10   &kp F11
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4    &kp N5              &kp N6     &kp N7    &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R     &kp T              &kp Y      &kp U     &kp I      &kp O     &kp P     &kp BSLH
&kp LCTRL  &kp A      &kp S     &kp D     &kp F     &kp G              &kp H      &kp J     &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V     &kp B              &kp N      &kp M     &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&kp LEFT   &kp RIGHT  &kp LGUI  &kp LALT  &kp SQT                                 &kp LBKT  &kp LBKT   &kp RBKT  &kp UP    &kp DOWN
                                          &kp LGUI  &kp RET   &kp DEL      &kp BSPC   &kp SPACE &mo 1
                                          &kp HOME  &kp END   &kp ESC      &kp GRAVE  &kp CAPS  &kp K_APP
            >;
        };

        fn_layer {
            bindings = <
&bootloader &sys_reset &trans   &trans    &trans    &trans             &trans     &trans    &trans     &trans    &trans    &trans
&trans     &trans     &trans    &trans    &trans    &trans             &trans     &trans    &trans     &trans    &trans    &trans
&trans     &trans     &trans    &trans    &trans    &trans             &trans     &kp HOME  &kp UP     &kp END   &trans    &trans
&trans     &trans     &trans    &trans    &trans    &trans             &trans     &kp LEFT  &kp DOWN   &kp RIGHT &trans    &trans
&trans     &trans     &trans    &trans    &trans    &trans             &trans     &trans    &trans     &trans    &trans    &trans
&trans     &trans     &trans    &trans    &trans                                  &trans    &trans     &trans    &trans    &trans
                                          &trans    &trans    &trans       &trans     &trans    &trans
                                          &trans    &trans    &trans       &trans     &trans    &trans
            >;
        };
    };
};
