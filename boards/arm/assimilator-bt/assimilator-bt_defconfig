# SPDX-License-Identifier: MIT

CONFIG_SOC_SERIES_NRF52X=y
CONFIG_SOC_NRF52840_QIAA=y
CONFIG_BOARD_ASSIMILATOR_BT=y

# Enable MPU
CONFIG_ARM_MPU=y
# Enable 32kHz crystal
CONFIG_CLOCK_CONTROL_NRF_K32SRC_XTAL=y
CONFIG_CLOCK_CONTROL_NRF_K32SRC_150PPM=y

# Use pinctrl
CONFIG_PINCTRL=y

# enable GPIO
CONFIG_GPIO=y

CONFIG_USE_DT_CODE_PARTITION=y
CONFIG_BUILD_OUTPUT_UF2=y

CONFIG_MPU_ALLOW_FLASH_WRITE=y
CONFIG_NVS=y
CONFIG_SETTINGS_NVS=y
CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y

CONFIG_ZMK_BLE=y
CONFIG_ZMK_USB=y

# Publish the firmware revision over the BLE Device Information Service so a
# flashed Imprint build is identifiable — read the DIS Firmware Revision
# characteristic (0x2A26) to confirm which build is running. The bool gates the
# string: without CONFIG_BT_DIS_FW_REV=y, a CONFIG_BT_DIS_FW_REV_STR override
# (as zmk-environment/build.sh --fw-version passes) is silently inert, which is
# exactly why earlier Imprint RCs carried no identifying version. "dev" is the
# placeholder for local builds; release/RC builds override the string via
# build.sh --fw-version. Mirrors boards/arm/speller/speller_defconfig.
CONFIG_BT_DIS_FW_REV=y
CONFIG_BT_DIS_FW_REV_STR="dev"

CONFIG_ZMK_MAX17048=y
CONFIG_I2C=y
CONFIG_ZMK_BATTERY_REPORT_INTERVAL=60
